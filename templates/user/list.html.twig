
<h1> liste des utilisateurs </h1>
<table border="1">
 <tr>
   <th>Id</th>
   <th>Nom</th>
   <th>Age</th>
   <th>Actions</th>
   <th>Images</th>
 </tr>
  {% for u in users%}
   
  <tr>
    <td>{{u.id}}</td>
    <td>{{u.name | upper}}</td>
    <td>{{u.age}}</td>
    <td> <img src="{{u.image}}" alt="{{u.name}}'s image" width="50px" height="50px">  </td>
    
    <td> 
      {%  if u.age > 30 %}
      <input type="submit" value="like">
       {% endif %}
      <a href="{{path('d',{'nom':u.name})}}">show</a>
    </td>
      </tr>
   
     {% endfor %}

</table>

